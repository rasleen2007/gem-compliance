# --- Backend ---
APP_ENV=development
API_V1_PREFIX=/api/v1
# Defaults are repo-root anchored (data/sih_local.db) when unset
DB_PATH=./data/sih_local.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,docx

# --- Phase P0 demo rule config ---
DEMO_TENDER_ID=GeM/2026/B/123456
EMD_THRESHOLD=50000

# --- AI Core ---
OCR_ENGINE=pymupdf            # pymupdf (P0, vector PDFs) | paddleocr (P1, scanned)
OCR_LANG=en
NLP_MODEL=spacy_en_core_web_sm
LLM_ENABLED=false
LLM_PROVIDER=gemini           # gemini | openai | local
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# --- Security / CORS (dev) ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO