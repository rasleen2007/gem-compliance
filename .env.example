# --- Backend ---
APP_ENV=development
API_V1_PREFIX=/api/v1
DB_PATH=./data/ge_m_compliance.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,docx

# --- AI Core ---
OCR_ENGINE=paddleocr          # paddleocr | tesseract (MVP default: paddleocr)
OCR_LANG=en
NLP_MODEL=spacy_en_core_web_sm
LLM_ENABLED=false
LLM_PROVIDER=gemini           # gemini | openai | local
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# --- Security / CORS (dev) ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO