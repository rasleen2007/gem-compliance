{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "validation_result.schema.json",
  "title": "ValidationResult",
  "description": "Output of core_ai/rules engine. Per-rule verdicts with evidence, plus aggregated overall status for the bid.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "tender_id", "bid_id", "generated_at", "results", "overall_status", "score"],
  "properties": {
    "request_id": { "type": "string", "format": "uuid" },
    "tender_id": { "type": "string" },
    "bid_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "engine_version": { "type": "string" },
    "results": {
      "type": "array",
      "items": { "$ref": "#/definitions/rule_result" }
    },
    "overall_status": { "type": "string", "enum": ["COMPLIANT", "DISCREPANT", "NEEDS_REVIEW"] },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking", "mandatory", "advisory", "pass", "fail", "warn", "total", "compliance_pct"],
      "properties": {
        "blocking": { "type": "integer", "minimum": 0 },
        "mandatory": { "type": "integer", "minimum": 0 },
        "advisory": { "type": "integer", "minimum": 0 },
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "skip": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "compliance_pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  },
  "definitions": {
    "rule_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "status", "confidence"],
      "properties": {
        "rule_id": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "fail", "warn", "skip", "error"] },
          "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "found": { "type": "string", "description": "Raw extracted text that satisfied/failed the rule" },
            "source_span": {
              "type": "object",
              "properties": {
                "page": { "type": "integer" },
                "start": { "type": "integer" },
                "end": { "type": "integer" },
                "bbox": { "type": "array", "items": { "type": "number" } }
              }
            },
            "file_id": { "type": "string", "format": "uuid" },
            "table_id": { "type": "string" },
            "distinct_values": { "type": ["array", "null"], "items": { "type": "string" }, "description": "Normalized distinct values when a cross_check field disagrees across documents" },
            "conflict_records": { "type": ["array", "null"], "items": { "type": "object" }, "description": "Full per-document conflict records from the cross-check pass" },
            "cross_check_conflict": { "type": "boolean", "description": "True when a cross_check operator detected a multi-document identity mismatch" }
          }
        },
        "reason": { "type": "string", "description": "Human-readable justification" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "suggested_action": {
          "type": "string",
          "enum": ["none", "attach_missing_doc", "correct_value", "reupload", "manual_review"]
        }
      }
    }
  }
}